---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TelegramSpotlight from '../components/TelegramSpotlight.astro';
import PillarsSection from '../components/PillarsSection.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import RulesSection from '../components/RulesSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Navbar activePath="/" />
  <main class="flex-1">
    <Hero />
    <TelegramSpotlight />
    <PillarsSection />
    <ProjectsShowcase />
    <RulesSection />
    <BlogPreview />
  </main>
  <Footer />
</BaseLayout>
