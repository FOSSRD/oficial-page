---
import Icons from './Icons.astro';
import { BLOG_PREVIEWS } from '../data/community';
---

<section id="blog" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-[#38BDF8]">
          // /blog
        </span>
        <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Lecturas y notas de la comunidad
        </h2>
        <p class="mt-2 max-w-2xl text-base text-slate-400">
          Espacio reservado en <code class="font-mono text-slate-200">/blog</code> para reunir los artículos publicados por miembros sobre Open Source, tecnología e IT.
        </p>
      </div>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 self-start rounded-xl border border-white/15 bg-white/[0.04] px-4 py-2.5 text-sm font-semibold text-white transition hover:border-[#38BDF8]/50 hover:bg-white/[0.08]"
      >
        <Icons name="book" class="h-4 w-4 text-[#38BDF8]" />
        <span>Ver sección /blog</span>
        <Icons name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {BLOG_PREVIEWS.map((post) => (
        <article class="card-glass flex flex-col justify-between rounded-2xl p-6 transition hover:-translate-y-0.5">
          <div>
            <div class="flex items-center justify-between gap-2 font-mono text-xs">
              <span class="rounded-md bg-[#002D62]/70 px-2.5 py-1 text-[#7dd3fc] ring-1 ring-[#38BDF8]/25">
                {post.tag}
              </span>
              <span class="text-slate-400">{post.readTime}</span>
            </div>

            <h3 class="mt-4 font-display text-xl font-bold text-white">
              {post.title}
            </h3>

            <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
              {post.excerpt}
            </p>
          </div>

          <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4 text-xs">
            <span class="font-mono text-slate-400">{post.status}</span>
            <a
              href="/blog"
              class="font-semibold text-[#38BDF8] transition hover:text-white"
            >
              Ver en /blog →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
