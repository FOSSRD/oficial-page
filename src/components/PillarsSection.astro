---
import Icons from './Icons.astro';
import { PILLARS } from '../data/community';
---

<section id="pilares" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-[#38BDF8]">
        // Qué encontrarás dentro
      </span>
      <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Conocimiento práctico compartido por gente que está en la trinchera.
      </h2>
      <p class="mt-3 text-base text-slate-400">
        Aquí se habla de cualquier tema de computación y tecnología, con el mundo Open Source como punto de partida.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {PILLARS.map((pillar) => {
        const isRed = pillar.accent === 'red';
        return (
          <article class="card-glass group rounded-2xl p-6 sm:p-7 transition duration-200 hover:-translate-y-0.5">
            <div class="flex items-start justify-between gap-4">
              <div
                class:list={[
                  'inline-flex h-12 w-12 items-center justify-center rounded-xl ring-1',
                  isRed
                    ? 'bg-[#CE1126]/15 text-[#ff6b7d] ring-[#CE1126]/35'
                    : 'bg-[#002D62]/60 text-[#38BDF8] ring-[#38BDF8]/30',
                ]}
              >
                <Icons name={pillar.icon} class="h-6 w-6" />
              </div>

              <div class="flex flex-wrap justify-end gap-1.5">
                {pillar.tags.map((tag) => (
                  <span class="rounded-md bg-white/[0.04] px-2 py-0.5 font-mono text-[11px] text-slate-400 ring-1 ring-white/10">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <h3 class="mt-5 font-display text-xl font-bold text-white">
              {pillar.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
              {pillar.description}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
