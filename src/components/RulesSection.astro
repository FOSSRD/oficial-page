---
import Icons from './Icons.astro';
import { COMMUNITY, COMMUNITY_RULES } from '../data/community';
---

<section id="reglas" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="card-glass overflow-hidden rounded-3xl p-7 sm:p-10">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/[0.05] px-3 py-1 font-mono text-xs text-slate-300 ring-1 ring-white/10">
            <Icons name="shield" class="h-3.5 w-3.5 text-emerald-400" />
            <span>Convivencia sana</span>
          </div>

          <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-white">
            Reglas claras para un grupo útil y respetuoso.
          </h2>

          <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">
            En Telegram valoramos el tiempo de todos. Cuidamos un ambiente positivo donde preguntar sea cómodo y las conversaciones técnicas aporten valor real.
          </p>

          <a
            href={COMMUNITY.rulesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[#38BDF8] transition hover:text-white"
          >
            <span>Leer reglamento completo</span>
            <Icons name="external" class="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {COMMUNITY_RULES.map((rule) => (
            <div class="rounded-2xl border border-white/10 bg-[#060B17]/80 p-5">
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'font-mono text-xs font-bold px-2 py-0.5 rounded-md',
                    rule.accent === 'red'
                      ? 'bg-[#CE1126]/20 text-[#ff6b7d]'
                      : 'bg-[#002D62]/80 text-[#7dd3fc]',
                  ]}
                >
                  {rule.number}
                </span>
                <h3 class="font-display text-base font-bold text-white">{rule.title}</h3>
              </div>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
                {rule.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
