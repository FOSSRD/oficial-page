---
import '../styles/global.css';
import { COMMUNITY } from '../data/community';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${COMMUNITY.name} — Comunidad Open Source & Telegram de República Dominicana`,
  description = COMMUNITY.description,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050811" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/img/fossrd-logo.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="FOSS-RD, Open Source, Software Libre, República Dominicana, Telegram, Linux, Sistemas Operativos, Tecnología, Computación, Comunidad Tech"
    />

    <!-- OpenGraph / Telegram & GitHub Link Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fossrd.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fossrd.com/img/fossrd-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-[#050811] text-slate-100 antialiased overflow-x-hidden relative">
    <!-- Atmospheric brand glows matching #002D62 (Dominican Navy) and #CE1126 (Dominican Crimson) -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute -top-48 -left-40 h-[560px] w-[560px] rounded-full bg-[#002D62]/45 blur-[130px]"></div>
      <div class="absolute -top-32 right-[-140px] h-[460px] w-[460px] rounded-full bg-[#CE1126]/22 blur-[140px]"></div>
      <div class="absolute bottom-[-220px] left-1/3 h-[420px] w-[520px] rounded-full bg-[#002D62]/25 blur-[140px]"></div>
      <div class="absolute inset-0 bg-tech-grid opacity-70 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_80%)]"></div>
    </div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
